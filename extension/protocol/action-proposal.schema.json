{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carina://protocol/v1/action-proposal.schema.json",
  "title": "ActionProposal",
  "type": "object",
  "properties": {
    "type": { "const": "ACTION_PROPOSAL" },
    "version": { "const": 1 },
    "nonce": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "candidateId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "pluginId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9._-]+$" },
    "intent": { "type": "string", "enum": ["SkipInterruption", "ContinuePlayback", "CloseOverlay"] },
    "proposedAction": { "const": "click" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceCodes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": { "type": "string", "enum": ["VISIBLE", "ENABLED", "INTERACTIVE_ROLE", "SUPPORTED_CONTROL_TEXT", "MEDIA_PLAYING", "OVERLAY_VISIBLE", "PLUGIN_SITE_SIGNAL"] }
    },
    "observedAt": { "type": "integer", "minimum": 0 }
  },
  "required": ["type", "version", "nonce", "candidateId", "pluginId", "intent", "proposedAction", "confidence", "evidenceCodes", "observedAt"],
  "additionalProperties": false
}
