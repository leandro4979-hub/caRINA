{
  "name": "clever-ai-guardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test tests/*.test.ts",
    "eval": "node evals/runner.ts",
    "check": "pnpm build && pnpm test && python3 -m unittest discover -s tests -p \"test_*.py\" && pnpm eval",
    "capture": "node scripts/capture-fixture.ts",
    "review": "node src/cli.ts"
  },
  "packageManager": "pnpm@10.18.3"
}
